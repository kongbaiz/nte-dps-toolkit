**/UETools-NTE/
# Retired native plugin build/cache files are not source deliverables.
/native/nte-mods-plugin/.vs/
/native/nte-mods-plugin/x64/
/native/nte-mods-plugin/*.user
/nte-resource-exporter/
/SDK/
/Dumper-7/
/tools/
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/
/UnrealExporter/
/NTE-Drive-Calculator/
/tests/
/plugins/*.dll
/plugins/mods-plugin.state.json
/plugins/equipment-plugin.state.json
/site/assets/

# Office creates transient lock files beside documents.
~$*.docx

# Local environment and secrets
.env
.env.*
!.env.example

# C# / MSBuild build artifacts (contain local user paths)
**/bin/
!src/bin/
!src/bin/nte-core.rs
**/obj/

