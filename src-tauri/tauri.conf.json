{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NTE DPS TOOL",
  "version": "0.4.3",
  "identifier": "io.github.kongbaiz.nte-dps-tool",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../frontend"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main-dps",
        "title": "NTE DPS TOOL",
        "url": "main-dps.html",
        "width": 670,
        "height": 560,
        "minWidth": 420,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "backgroundColor": "#f6f7f8",
        "decorations": false,
        "alwaysOnTop": false,
        "shadow": true,
        "skipTaskbar": false,
        "center": true,
        "visible": false
      },
      {
        "label": "hud-spike",
        "title": "NTE DPS TOOL - HUD Spike",
        "url": "hud.html",
        "width": 380,
        "height": 238,
        "minWidth": 280,
        "minHeight": 180,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      },
      {
        "label": "notification-island",
        "title": "NTE DPS TOOL - Notification",
        "url": "notification.html",
        "width": 440,
        "height": 76,
        "minWidth": 320,
        "minHeight": 64,
        "maxWidth": 560,
        "maxHeight": 120,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      },
      {
        "label": "console",
        "title": "NTE Console",
        "url": "console.html",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "backgroundColor": "#f6f7f8",
        "decorations": false,
        "alwaysOnTop": false,
        "shadow": true,
        "skipTaskbar": false,
        "center": true,
        "visible": false
      },
      {
        "label": "abyss-values",
        "title": "NTE Abyss Values",
        "url": "abyss-values.html",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": false,
        "shadow": true,
        "skipTaskbar": false,
        "center": true,
        "visible": false
      },
      {
        "label": "character-details",
        "title": "NTE DPS TOOL - Character Combat Details",
        "url": "combat-details.html",
        "width": 880,
        "height": 620,
        "minWidth": 620,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "backgroundColor": "#f6f7f8",
        "decorations": false,
        "alwaysOnTop": false,
        "shadow": true,
        "skipTaskbar": false,
        "center": true,
        "visible": false
      },
      {
        "label": "team-details",
        "title": "NTE DPS TOOL - Team Combat Details",
        "url": "combat-details.html",
        "width": 980,
        "height": 680,
        "minWidth": 620,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "backgroundColor": "#f6f7f8",
        "decorations": false,
        "alwaysOnTop": false,
        "shadow": true,
        "skipTaskbar": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": "default-src 'self' http://localhost:5173; connect-src ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
