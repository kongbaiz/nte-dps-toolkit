+pub(crate) fn dismiss_island_notice(
+    notice_id: String,
+    state: State<'_, AppState>,
+    window: WebviewWindow,
+) -> Result<IslandSnapshot, CommandError> {
+    island::validate_window(&window)?;
+    state.dismiss_island_notice(&notice_id);
