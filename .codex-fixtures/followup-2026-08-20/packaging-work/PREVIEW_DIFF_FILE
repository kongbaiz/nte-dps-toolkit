+impl Drop for OwnedHandle {
+    fn drop(&mut self) {
+        if !self.0.is_null() && self.0 != INVALID_HANDLE_VALUE {
+            // SAFETY: this wrapper exclusively owns one checked Win32 handle.
+            unsafe {
+                CloseHandle(self.0);
+            }
