+fn add_damage_delta(value: &mut f64, delta: f64) {
+    *value += delta;
+    // Repeated floating-point corrections can leave a negative zero or a tiny
+    // residual even though every authoritative damage input is non-negative.
+    if value.abs() <= 1e-9 {
+        *value = 0.0;
+    }
+}
