+        let before = find_recent_hit(&self.hits, locator).cloned();
+        let Some(mutation) =
+            apply_damage_correction_to_recent_hit(&mut self.hits, locator, &correction)
+        else {
+            return false;
+        };
+        if let (Some(before), Some(after)) = (before, find_recent_hit(&self.hits, locator)) {
