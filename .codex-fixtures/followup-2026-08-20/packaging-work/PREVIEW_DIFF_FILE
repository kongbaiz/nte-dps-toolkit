+fn character_duration_after_time_stop(
+    row: &CharacterStats,
+    time_stop: &TimeStopTracker,
+    subtract_time_stop: bool,
+) -> f64 {
+    let raw = row.duration();
+    if raw <= 0.0 {
+        return 0.0;
+    }
+    if !subtract_time_stop {
+        return raw;
+    }
+    (raw - time_stop.frozen_between(row.first_hit, row.last_hit)).max(0.001)
+}
