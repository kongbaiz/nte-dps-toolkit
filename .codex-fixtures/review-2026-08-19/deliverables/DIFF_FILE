+        [Parameter(Mandatory = $true)][string]$Pattern,
+        [Parameter(Mandatory = $true)][string]$Message
+    )
+    if ($Text -notmatch $Pattern) {
+        throw $Message
+    }
+}
+
+function Reject-Pattern {
+    param(
+        [Parameter(Mandatory = $true)][string]$Text,
+        [Parameter(Mandatory = $true)][string]$Pattern,
+        [Parameter(Mandatory = $true)][string]$Message
+    )
+    if ($Text -match $Pattern) {
+        throw $Message
+    }
+}
